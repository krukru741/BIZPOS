generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  password           String
  role               String   // Admin, Manager, Cashier
  status             String   @default("ACTIVE")
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  auditLogs          AuditLog[]
  openedSessions     CashSession[] @relation("OpenedSessions")
  closedSessions     CashSession[] @relation("ClosedSessions")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  products  Product[]
}

model Product {
  id            String   @id @default(uuid())
  barcode       String?  @unique
  name          String
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  brand         String?
  unit          String?
  costPrice     Float
  sellingPrice  Float
  currentStock  Int      @default(0)
  reorderLevel  Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  saleItems         SaleItem[]
  inventoryMovements InventoryMovement[]

  @@index([barcode])
  @@index([name])
}

model CashSession {
  id           String    @id @default(uuid())
  sessionNo    String    @unique
  openedById   String
  openedBy     User      @relation("OpenedSessions", fields: [openedById], references: [id])
  closedById   String?
  closedBy     User?     @relation("ClosedSessions", fields: [closedById], references: [id])
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingCash  Float
  expectedCash Float?
  actualCash   Float?
  variance     Float?
  status       String    @default("OPEN") // OPEN, BALANCED, SHORT, OVER

  sales        Sale[]
  movements    CashMovement[]
}

model CashMovement {
  id            String      @id @default(uuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  type          String      // CASH_IN, CASH_OUT
  amount        Float
  reason        String
  note          String?
  createdAt     DateTime    @default(now())
}

model Sale {
  id              String     @id @default(uuid())
  transactionNo   String     @unique // Format: SALE-YYYYMMDD-000001
  cashSessionId   String?
  cashSession     CashSession? @relation(fields: [cashSessionId], references: [id])
  totalAmount     Float
  discountAmount  Float      @default(0)
  netAmount       Float
  status          String     @default("COMPLETED")
  createdAt       DateTime   @default(now())

  items           SaleItem[]
  payment         Payment?

  @@index([transactionNo])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  unitCost  Float
  subtotal  Float
}

model Payment {
  id            String   @id @default(uuid())
  saleId        String   @unique
  sale          Sale     @relation(fields: [saleId], references: [id])
  method        String   // CASH, GCASH, CARD
  amountReceived Float
  change        Float
  createdAt     DateTime @default(now())
}

model InventoryMovement {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String   // STOCK_IN, SALE, DAMAGED, ADJUSTMENT
  quantity  Int      // Positive for stock in/adjustment up, negative for sale/damaged/adjustment down
  remarks   String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}
